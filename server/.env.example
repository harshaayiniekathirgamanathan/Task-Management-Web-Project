# PostgreSQL connection (Azure Database for PostgreSQL Flexible Server).
# Format: postgres://<user>:<pwd>@<server>.postgres.database.azure.com:5432/<db>?sslmode=require
DATABASE_URL=postgres://user:password@host.postgres.database.azure.com:5432/taskmanager?sslmode=require
# Set to "disable" only when pointing DATABASE_URL at a local Postgres without TLS.
# DATABASE_SSL=disable

# Azure Blob Storage for task attachments.
# Get the connection string from the storage account (Access keys) in the portal.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ATTACHMENTS_CONTAINER=attachments

# JWT secrets — paste two long random strings (see tip below)
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string

# Frontend URL (used for CORS)
CLIENT_URL=http://localhost:5173

# Server port
PORT=8000

NODE_ENV=development

# SMTP onboarding email.
# For Gmail, enable 2-Step Verification and use a Google App Password here.
# Spaces in the app password are safe; the app strips them before sending.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your16charapppassword
MAIL_FROM="Task Management <youraddress@gmail.com>"

# Optional local fallback. Set this to true only for local development if you
# want user creation to print the temporary password instead of sending email.
ALLOW_CONSOLE_ONBOARDING=false
